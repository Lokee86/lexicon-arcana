{
  "version": 1,
  "profile": "library-engine",
  "capabilities": [
    "stateful",
    "data-pipeline"
  ],
  "docs_root": "lexicon/docs",
  "root_index": "lexicon/docs/README.md",
  "folder_index": "README.md",
  "required_paths": [
    "lexicon/README.md",
    "lexicon/docs/README.md",
    "lexicon/docs/HOWTO.md",
    "lexicon/docs/ADAPTER_AUTHORING.md",
    "lexicon/docs/ADAPTER_GO_COMPATIBILITY.md",
    "lexicon/docs/APPLICATION.md",
    "lexicon/docs/ARCHITECTURE.md",
    "lexicon/docs/MAINTAINER_MAP.md",
    "lexicon/docs/DEVELOPMENT.md",
    "lexicon/docs/STATUS.md",
    "lexicon/docs/RUST_MIGRATION.md"
  ],
  "index_exempt_directories": [
    "stubs"
  ],
  "section_exemptions": [
    "lexicon/docs/README.md"
  ],
  "required_sections": [
    "Purpose",
    "Overview",
    "Related docs",
    "Notes"
  ],
  "coverage": [
    {
      "paths": [
        "lexicon-cli/**",
        "lexicon/src/api/**",
        "lexicon/src/config/**",
        "lexicon/src/repository/**"
      ],
      "docs": [
        "lexicon/docs/HOWTO.md",
        "lexicon/docs/APPLICATION.md",
        "lexicon/docs/DEVELOPMENT.md",
        "lexicon/docs/RUST_MIGRATION.md"
      ]
    },
    {
      "paths": [
        "lexicon/src/scan/**",
        "lexicon/src/storage/**",
        "lexicon/src/watch/**",
        "lexicon/src/consumer/**",
        "lexicon/src/lookup/**",
        "lexicon/src/interstack/**",
        "lexicon/src/scope.rs"
      ],
      "docs": [
        "lexicon/docs/ARCHITECTURE.md",
        "lexicon/docs/APPLICATION.md",
        "lexicon/docs/DEVELOPMENT.md",
        "lexicon/docs/RUST_MIGRATION.md"
      ]
    },
    {
      "paths": [
        "lexicon/src/adapters/**",
        "lexicon/src/languages/**",
        "lexicon/adapters/**"
      ],
      "docs": [
        "lexicon/adapters/README.md",
        "lexicon/docs/ARCHITECTURE.md",
        "lexicon/docs/SEMANTIC_ACCEPTANCE.md",
        "lexicon/docs/STATUS.md",
        "lexicon/docs/RUST_MIGRATION.md"
      ]
    },
    {
      "paths": [
        "lexicon/spec/**"
      ],
      "docs": [
        "lexicon/docs/ARCHITECTURE.md",
        "lexicon/docs/DEPENDENCY_SEMANTICS.md",
        "lexicon/docs/STATUS.md"
      ]
    },
    {
      "paths": [
        "lexicon/evaluation/**",
        "lexicon/tools/**",
        "scripts/workflow.py"
      ],
      "docs": [
        "lexicon/docs/DEVELOPMENT.md",
        "lexicon/docs/SEMANTIC_CORPUS_VALIDATION.md",
        "lexicon/docs/RELEASE_PACKAGING.md"
      ]
    }
  ],
  "change_rules": [
    {
      "paths": [
        "lexicon-cli/**",
        "lexicon/src/api/**",
        "lexicon/src/config/**",
        "lexicon/src/repository/**"
      ],
      "docs": [
        "lexicon/docs/APPLICATION.md",
        "lexicon/docs/DEVELOPMENT.md",
        "lexicon/docs/RUST_MIGRATION.md",
        "docs/reference/lexicon.md"
      ]
    },
    {
      "paths": [
        "lexicon/src/scan/**",
        "lexicon/src/storage/**",
        "lexicon/src/watch/**",
        "lexicon/src/consumer/**",
        "lexicon/src/lookup/**",
        "lexicon/src/interstack/**",
        "lexicon/src/scope.rs"
      ],
      "docs": [
        "lexicon/docs/ARCHITECTURE.md",
        "lexicon/docs/APPLICATION.md",
        "lexicon/docs/RUST_MIGRATION.md",
        "docs/development/behavioral-contract-matrix.md"
      ]
    },
    {
      "paths": [
        "lexicon/src/adapters/**",
        "lexicon/src/languages/**",
        "lexicon/adapters/**"
      ],
      "docs": [
        "lexicon/adapters/**/README.md",
        "lexicon/adapters/README.md",
        "lexicon/docs/SEMANTIC_ACCEPTANCE.md",
        "lexicon/docs/STATUS.md",
        "lexicon/docs/RUST_MIGRATION.md",
        "docs/reference/lexicon.md"
      ]
    },
    {
      "paths": [
        "lexicon/spec/**"
      ],
      "docs": [
        "lexicon/docs/ARCHITECTURE.md",
        "lexicon/docs/DEPENDENCY_SEMANTICS.md",
        "lexicon/docs/STATUS.md",
        "docs/reference/lexicon.md"
      ]
    },
    {
      "paths": [
        "lexicon/evaluation/**",
        "lexicon/tools/**",
        "scripts/workflow.py"
      ],
      "docs": [
        "lexicon/docs/DEVELOPMENT.md",
        "lexicon/docs/SEMANTIC_CORPUS_VALIDATION.md",
        "lexicon/docs/RELEASE_PACKAGING.md"
      ]
    }
  ]
}
