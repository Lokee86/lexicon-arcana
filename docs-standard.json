{
  "version": 1,
  "profile": "cli-product",
  "capabilities": [
    "stateful",
    "protocol",
    "data-pipeline",
    "research"
  ],
  "docs_root": "docs",
  "root_index": "docs/INDEX.md",
  "folder_index": "INDEX.md",
  "required_paths": [
    "README.md",
    "AGENTS.md",
    "docs/INDEX.md",
    "docs/documentation-policy.md",
    "docs/documentation-procedure.md",
    "docs/architecture/analysis-stack.md",
    "docs/architecture/components.md",
    "docs/architecture/system-overview.md",
    "docs/decisions/INDEX.md",
    "docs/development/architecture-verification.md",
    "docs/planning/roadmap.md",
    "docs/limits/current-limitations.md",
    "docs/development/documentation-coverage.md",
    "docs/development/behavioral-contract-matrix.md",
    "lexicon/docs/README.md",
    "arcana/docs/README.md"
  ],
  "index_exempt_directories": [
    "stubs"
  ],
  "section_exemptions": [
    "docs/INDEX.md",
    "docs/**/INDEX.md",
    "docs/development/recent-changes-2026-07.md"
  ],
  "required_sections": [
    "Purpose",
    "Overview",
    "Related docs",
    "Notes"
  ],
  "coverage": [
    {
      "paths": [
        "scripts/**",
        ".github/workflows/**",
        "tools/pitlord/**"
      ],
      "docs": [
        "docs/development/release-workflow.md",
        "docs/development/architecture-verification.md",
        "docs/development/documentation-coverage.md"
      ]
    },
    {
      "paths": [
        "evaluation/**"
      ],
      "docs": [
        "docs/development/testing-and-benchmarks.md",
        "docs/development/retrieval-quality.md",
        "docs/development/agent-benchmark-findings.md"
      ]
    },
    {
      "paths": [
        "lexicon/**"
      ],
      "docs": [
        "lexicon/docs/README.md",
        "docs/reference/lexicon.md",
        "docs/development/documentation-coverage.md"
      ]
    },
    {
      "paths": [
        "arcana/**"
      ],
      "docs": [
        "arcana/docs/README.md",
        "docs/reference/arcana.md",
        "docs/development/documentation-coverage.md"
      ]
    }
  ],
  "change_rules": [
    {
      "paths": [
        "scripts/**",
        ".github/workflows/**",
        "tools/pitlord/**"
      ],
      "docs": [
        "docs/development/release-workflow.md",
        "docs/development/architecture-verification.md",
        "docs/development/documentation-coverage.md"
      ]
    },
    {
      "paths": [
        "evaluation/**"
      ],
      "docs": [
        "docs/development/testing-and-benchmarks.md",
        "docs/development/retrieval-quality.md",
        "docs/development/agent-benchmark-findings.md"
      ]
    },
    {
      "paths": [
        "lexicon/**"
      ],
      "docs": [
        "lexicon/docs/README.md",
        "docs/reference/lexicon.md",
        "docs/development/documentation-coverage.md"
      ]
    },
    {
      "paths": [
        "arcana/**"
      ],
      "docs": [
        "arcana/docs/README.md",
        "docs/reference/arcana.md",
        "docs/development/documentation-coverage.md"
      ]
    }
  ]
}
